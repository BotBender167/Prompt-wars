# ─────────────────────────────────────────────
# Cohort — Environment Variable Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────

# Supabase — exposed to browser (safe)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Supabase — server-only (never send to browser)
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# GitHub — optional, raises API rate limit from 60 to 5 000 req/hr
# Create a classic Personal Access Token with no scopes (public data only)
GITHUB_TOKEN=<github-personal-access-token>

# Anthropic — optional, used by /api/message to draft intro messages.
# Without it the route falls back to a templated draft built from profile data.
ANTHROPIC_API_KEY=<anthropic-api-key>
